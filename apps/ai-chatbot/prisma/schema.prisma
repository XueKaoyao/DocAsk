// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id        String   @id @default(uuid())
  title     String
  /// 原始文件名或来源标识（检索过滤 / 引用展示）；无文件时可用 title
  filename  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  // chunks    Chunk[]
}

model Message {
  id              String @id @default(cuid())
  sessionId       String
  session         Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parts           Json[]
  role            String
  createdAt DateTime @default(now())
  @@index([sessionId])
}

model Session {
  id        String   @id @default(cuid())
  title     String
  systemPrompt Json
  temperature Float
  userId    String
  user      User     @relation(fields:[userId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[] //消息数组
  @@index([userId])
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

