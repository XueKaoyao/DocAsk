{
  "name": "ai-chatbot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "seed:docs": "node scripts/seed-documents.mjs",
    "delete:docs": "node scripts/delete-documents.mjs",
    "inspect:lancedb": "node scripts/inspect-lancedb.mjs",
    "explain:queries": "node scripts/explain-queries.mjs",
    "rebuild:bm25": "node scripts/rebuild-bm25.mjs",
    "chat:logs": "node scripts/watch-chat-logs.mjs",
    "erd": "node scripts/generate-erd.mjs",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage",
    "test:retrieval": "jest --config jest.config.cjs --testPathPatterns=retrievalTool",
    "eval:retrieval": "node scripts/eval-retrieval.mjs"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.35",
    "@ant-design/icons": "^6.2.3",
    "@ant-design/x-markdown": "^2.7.0",
    "@huggingface/transformers": "^4.2.0",
    "@lancedb/lancedb": "^0.31.0",
    "@myworkspace/LRUCache": "workspace:*",
    "@myworkspace/fetch": "workspace:*",
    "@myworkspace/indexedDB": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^6.0.185",
    "apache-arrow": "^18.1.0",
    "ioredis": "^6.0.0",
    "lodash": "^4.18.1",
    "mammoth": "^1.12.0",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.32.6",
    "undici": "^8.10.0",
    "wink-bm25-text-search": "^3.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
